{
  "name": "gamut-ng-host",
  "main": "worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTH_MODE": "true",
    "HOST": "127.0.0.1",
    "PORT": "8787",
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "PLATFORM_BASE_URL": "https://platform.gamutstaging.com",
    "PLATFORM_PROXY_URL": "https://platformproxy.gamutstaging.com",
    "PLATFORM_AUTH_ISSUER_URL": "https://auth.gamutstaging.com"
  },
  "assets": {
    "directory": "../../dist/renderer",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HOST_DO", "class_name": "HostDO" },
      { "name": "AGENT_CONTAINER", "class_name": "AgentContainer" }
    ]
  },
  "containers": [{ "class_name": "AgentContainer", "image": "../../agent-container/Dockerfile", "max_instances": 5 }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HostDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentContainer"] }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "gamut-ng-host", "database_id": "local-dev" }]
}
