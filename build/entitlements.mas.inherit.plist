<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Every other executable in the Mac App Store build: Electron's helpers,
       limactl and the bundled tools. They run in the app's own sandbox. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
  <!-- limactl's host agent drives Virtualization.framework, which checks the
       calling process's own signature for this key. -->
  <key>com.apple.security.virtualization</key>
  <true/>
</dict>
</plist>
