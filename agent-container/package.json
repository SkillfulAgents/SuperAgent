{
  "name": "superagent-container",
  "version": "1.0.0",
  "description": "Docker container running Claude Code with HTTP/WebSocket API",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && cp src/*.md dist/ && cp -R src/hints/builtin dist/hints/",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "claude",
    "ai",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "js-yaml": "^4.3.2",
    "llm-endpoint-translation": "https://github.com/SkillfulAgents/llm-endpoint-translation/releases/download/v0.1.6/llm-endpoint-translation-0.1.6.tgz",
    "mustache": "^4.2.0",
    "playwright-core": "^1.58.0",
    "sharp": "^0.33.5",
    "uuid": "^11.1.1",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^28.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
